{
  "name": "pg-rocket",
  "version": "0.0.0",
  "description": "A fast, lightweight PostgreSQL client for Node.",
  "scripts": {
    "bench": "pnpm --filter @pg-rocket/bench bench",
    "bench:seed": "pnpm --filter @pg-rocket/bench seed",
    "db:down": "docker compose -f packages/test-utils/docker-compose.yaml down",
    "db:logs": "docker compose -f packages/test-utils/docker-compose.yaml logs -f",
    "db:reset": "docker compose -f packages/test-utils/docker-compose.yaml down -v && docker compose -f packages/test-utils/docker-compose.yaml up -d --wait",
    "db:up": "docker compose -f packages/test-utils/docker-compose.yaml up -d --wait",
    "example": "pnpm --filter @pg-rocket/example start",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "lint:fix": "biome check --fix",
    "unused": "knip --cache"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260505.1",
    "knip": "^6.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "25.x",
    "pnpm": "10.x"
  }
}
